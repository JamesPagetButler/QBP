===== S (dim 16) =====
e_a^2 = -1 for all a: True
spectrum of D^2 = -L_s^2  (s = sum of imaginary units):
   [((15+0j), 16)]
  is D^2 = (n-1) I ? True
  Delta = sum_{a<b} {L_a,L_b}  spectrum: [(0j, 16)]
  D^2 == (n-1)I - Delta ? True
  random imaginary unit s, spectrum of -L_s^2: [((0.173772+0j), 4), ((1+0j), 8), ((1.826228+0j), 4)]
  random imaginary unit s, spectrum of -L_s^2: [((0.127913+0j), 4), ((1+0j), 8), ((1.872087+0j), 4)]
  C = -sum_a L_a^2 spectrum: [((15+0j), 16)]
