
===== H (dim 4) =====
e_a^2 = -1 for all a: True
spectrum of D^2 = -L_s^2  (s = sum of imaginary units):
   [((3+0j), 4)]
  is D^2 = (n-1) I ? True
  Delta = sum_{a<b} {L_a,L_b}  spectrum: [(0j, 4)]
  D^2 == (n-1)I - Delta ? True
  random imaginary unit s, spectrum of -L_s^2: [((1+0j), 4)]
  random imaginary unit s, spectrum of -L_s^2: [((1+0j), 4)]
  C = -sum_a L_a^2 spectrum: [((3+0j), 4)]
  ad-Casimir -sum_a ad(e_a)^2 spectrum: [((-0+0j), 1), ((8+0j), 3)]

