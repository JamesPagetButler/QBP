The L4 deliverable is `span4_mul_closed`; the adjoin inclusion is
`adjoin_pair_le_span4`. -/

#print axioms cdAlg_mul_zero
#print axioms cdAlg_zero_mul
#print axioms bilinear_mem_span
#print axioms xx_mem_span_gen4
#print axioms yx_mem_span_gen4
#print axioms x_xy_mem_span_gen4
#print axioms xy_y_mem_span_gen4
#print axioms xy_x_mem_span_gen4
#print axioms y_xy_mem_span_gen4
#print axioms xyxy_mem_span_gen4
#print axioms gen4_mul_mem_span
#print axioms span4_mul_closed
#print axioms adjoin_pair_le_span4
#print axioms mem_span4_of_mem_adjoin

end QBP.Foundations.CDAlg
